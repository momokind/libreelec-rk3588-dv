diff --git a/engine/shaders/p2_pack.frag b/engine/shaders/p2_pack.frag
--- a/engine/shaders/p2_pack.frag
+++ b/engine/shaders/p2_pack.frag
@@ -53,8 +53,11 @@
 // the rows the metadata packets reach, so neither is tested.
 layout(constant_id = 9) const uint INTERIOR = 0;
 layout(constant_id = 10) const uint NV15 = 0;
-// Output mode: 0 = DV tunnel (XRGB8888), 1 = HDR10 (XRGB2101010), 2 = SDR/WCG-SDR (XRGB2101010)
+// Output mode: 0 = DV tunnel (XRGB8888), 1 = HDR10, 2 = SDR/WCG-SDR
 layout(constant_id = 11) const uint OUTMODE = 0;
+// Non-tunnel output packing: 8 = XRGB8888, 10 = XRGB2101010. A spec constant,
+// so only one packing survives compilation.
+layout(constant_id = 12) const uint OUTBITS = 8;
 layout(binding = 16) uniform sampler2D overlay_codes;   // PO: (Y, Cb, Cr) x alpha / 4096, alpha
 
 uint packet_byte(uint i) { return (P.packets[i >> 4][(i >> 2) & 3u] >> (8u * (i & 3u))) & 255u; }
@@ -179,9 +182,12 @@
             enc = pow(clamp(rgb, 0.0, 1.0), vec3(P.tm_cfg.y));
         }
     }
-    float d = bayer4x4(x, y) * (1.0 / 255.0);
-    uvec3 q = uvec3(clamp(round((enc + d) * 255.0), 0.0, 255.0));
-    return (q.r << 16u) | (q.g << 8u) | q.b;
+    // XRGB8888 or XRGB2101010, per OUTBITS
+    float maxv = OUTBITS == 10u ? 1023.0 : 255.0;
+    float d = bayer4x4(x, y) * (1.0 / maxv);
+    uvec3 q = uvec3(clamp(round((enc + d) * maxv), 0.0, maxv));
+    return OUTBITS == 10u ? (q.r << 20u) | (q.g << 10u) | q.b
+                          : (q.r << 16u) | (q.g << 8u) | q.b;
 }
 
 uint finish(uint x, uint y, uint yy, uint c)
