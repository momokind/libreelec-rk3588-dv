diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/HDRVividDovi.c b/xbmc/cores/VideoPlayer/DVDDemuxers/HDRVividDovi.c
index 1111111..2222222 100644
--- a/xbmc/cores/VideoPlayer/DVDDemuxers/HDRVividDovi.c
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/HDRVividDovi.c
@@ -403,3 +403,82 @@ const AVDOVIMetadata *hdr10plus_dovi_next(struct hdrvivid_dovi_scene *s,
   *size = s->size;
   return s->made;
 }
+
+const AVDOVIMetadata *hdr10_dovi_next(struct hdrvivid_dovi_scene *s,
+                                      const AVMasteringDisplayMetadata *mastering,
+                                      const AVContentLightMetadata *light,
+                                      size_t *size, bool *repeated)
+{
+  if (!s || !size || !repeated)
+    return NULL;
+  *repeated = false;
+
+  AVMasteringDisplayMetadata default_mastering;
+  if (!mastering || !mastering->has_luminance || mastering->max_luminance.den <= 0 ||
+      mastering->min_luminance.den <= 0) {
+    memset(&default_mastering, 0, sizeof(default_mastering));
+    default_mastering.has_luminance = 1;
+    default_mastering.max_luminance = (AVRational){1000, 1};
+    default_mastering.min_luminance = (AVRational){1, 10000};
+    mastering = &default_mastering;
+  }
+
+  double max_nits = av_q2d(mastering->max_luminance);
+  if (!(max_nits > 0.0 && max_nits <= 10000.0))
+    max_nits = 1000.0;
+  if (light && light->MaxCLL > 0 && light->MaxCLL <= 10000)
+    max_nits = (double)light->MaxCLL;
+
+  double avg_nits = max_nits * 0.25;
+  if (avg_nits > 400.0)
+    avg_nits = 400.0;
+  if (light && light->MaxFALL > 0 && light->MaxFALL <= 10000)
+    avg_nits = (double)light->MaxFALL;
+  if (avg_nits > max_nits)
+    avg_nits = max_nits;
+
+  double min_nits = av_q2d(mastering->min_luminance);
+  if (!(min_nits >= 0.0 && min_nits < avg_nits))
+    min_nits = 0.0001;
+
+  struct hdrvivid_dovi_l1 l1;
+  l1.max_pq = code12(pq_from_linear(max_nits / 10000.0));
+  l1.avg_pq = code12(pq_from_linear(avg_nits / 10000.0));
+  l1.min_pq = code12(pq_from_linear(min_nits / 10000.0));
+  if (l1.avg_pq > l1.max_pq)
+    l1.avg_pq = l1.max_pq;
+  if (l1.min_pq > l1.avg_pq)
+    l1.min_pq = l1.avg_pq;
+  l1.min_raw = l1.min_pq;
+  l1.max_raw = l1.max_pq;
+  l1.avg_raw = l1.avg_pq;
+
+  if (s->made && s->have_l1 &&
+      s->last_l1.min_pq == l1.min_pq &&
+      s->last_l1.max_pq == l1.max_pq &&
+      s->last_l1.avg_pq == l1.avg_pq) {
+    *repeated = true;
+    *size = s->size;
+    return s->made;
+  }
+
+  size_t bytes = 0;
+  AVDOVIMetadata *first = make_profile81_metadata(l1.min_pq, l1.max_pq, l1.avg_pq,
+                                                  mastering, light, true, &bytes);
+  AVDOVIMetadata *made = first ? av_malloc(bytes) : NULL;
+  if (!made) {
+    av_free(first);
+    return NULL;
+  }
+  memcpy(made, first, bytes);
+  av_dovi_get_color(made)->scene_refresh_flag = 0;
+  av_free(s->first);
+  av_free(s->made);
+  s->first = first;
+  s->made = made;
+  s->size = bytes;
+  s->last_l1 = l1;
+  s->have_l1 = true;
+  *size = bytes;
+  return s->first;
+}
