   if (!probe.rpu)
   {
     if (!ProbeHdrVivid(stream, streamIdx, data, size, probed, PROBED_PACKETS))
-      ProbeHdr10Plus(stream, streamIdx, data, size, probed, PROBED_PACKETS);
+      if (!ProbeHdr10Plus(stream, streamIdx, data, size, probed, PROBED_PACKETS))
+        ProbeHdr10(stream, streamIdx, data, size, probed, PROBED_PACKETS);
     return;
   }
   probed = PROBED_PACKETS;
@@ -1485,6 +1487,45 @@ bool CDVDDemuxFFmpeg::ProbeHdr10Plus(CDemuxStream* stream,
   return true;
 }
 
+bool CDVDDemuxFFmpeg::ProbeHdr10(CDemuxStream* stream,
+                                 int streamIdx,
+                                 const uint8_t* data,
+                                 int size,
+                                 unsigned int& probed,
+                                 unsigned int done)
+{
+  if (m_dvFromHdr10.count(streamIdx))
+    return true;
+  const auto settings = CServiceBroker::GetSettingsComponent()->GetSettings();
+  if (!settings || !settings->GetBool(CSettings::SETTING_VIDEOPLAYER_DOLBYVISIONFROMHDR10))
+    return false;
+  // Give in-band DV RPU / HDR Vivid / HDR10+ SEI a few packets to appear first
+  if (probed < 8)
+    return false;
+
+  const AVStream* avStream = m_pFormatContext->streams[streamIdx];
+  if (!avStream->codecpar || avStream->codecpar->color_trc != AVCOL_TRC_SMPTE2084 ||
+      avStream->codecpar->color_primaries != AVCOL_PRI_BT2020)
+    return false;
+
+  probed = done;
+  AVDOVIDecoderConfigurationRecord record{};
+  const AVRational rate =
+      av_guess_frame_rate(m_pFormatContext, const_cast<AVStream*>(avStream), nullptr);
+  if (!CDVHdrVivid::Record(avStream->codecpar, rate, record))
+    return true;
+
+  CLog::Log(LOGINFO,
+            "CDVDDemuxFFmpeg: stream {} is static HDR10: promoting to Dolby Vision profile 8.1",
+            streamIdx);
+  auto* video = static_cast<CDemuxStreamVideo*>(stream);
+  m_dvPromoted[streamIdx] = record;
+  m_dvFromHdr10[streamIdx] = true;
+  video->doviFromHdr10 = true;
+  PromoteDolbyVision(stream, record, nullptr);
+  return true;
+}
