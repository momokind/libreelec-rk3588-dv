+
+bool CWinSystemGbm::SetOutputBitDepth(unsigned int bits)
+{
+  auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  if (!drm)
+    return false;
+
+  auto connector = drm->GetConnector();
+  if (!connector || !connector->SupportsProperty("max bpc"))
+    return false;
 
+  // the first value seen is the one to restore, as for the tunnel's
+  if (!m_outputSavedMaxBpc)
+    m_outputSavedMaxBpc = connector->GetPropertyValue("max bpc");
+
+  CLog::LogF(LOGDEBUG, "setting connector max bpc to {}", bits);
+  drm->AddProperty(connector, "max bpc", bits);
+  drm->SetActive(true);
   return true;
 }
 
+void CWinSystemGbm::RestoreOutputBitDepth()
+{
+  auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  if (!drm || !m_outputSavedMaxBpc)
+    return;
+
+  auto connector = drm->GetConnector();
+  if (connector && connector->SupportsProperty("max bpc"))
+  {
+    CLog::LogF(LOGDEBUG, "restoring connector max bpc to {}", m_outputSavedMaxBpc.value());
+    drm->AddProperty(connector, "max bpc", m_outputSavedMaxBpc.value());
+    drm->SetActive(true);
+  }
+  m_outputSavedMaxBpc.reset();
+}
+
+bool CWinSystemGbm::SupportsVideoPlaneFormat(uint64_t width,
+                                             uint64_t height,
+                                             uint32_t format,
+                                             uint64_t modifier)
+{
+  auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  if (!drm)
+    return false;
+
+  CDRMPlane* plane = drm->GetVideoPlane();
+  return plane && plane->Check(width, height, format, modifier, drm->GetCrtc(), PLANE_TYPE_ANY);
+}
