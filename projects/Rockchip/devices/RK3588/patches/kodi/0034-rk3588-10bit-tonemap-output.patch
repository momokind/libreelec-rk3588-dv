-CDVTunnelDRMPRIME::Options GetDolbyVisionOptions(const CVideoSettings& settings)
+/*!
+ * \brief Whether 10-bit RGB fits the mode's link.
+ *
+ * The RK3588 HDMI glue still runs TMDS only (no FRL): 600 MHz pixel clock
+ * ceiling. 10-bit RGB costs 1.25x the 8-bit clock; the blanking is taken
+ * generously at 1.5x the active pixel rate (4K24 ~1.5x, 4K60 ~1.2x).
+ */
+bool TenBitOutputFits(const RESOLUTION_INFO& info)
+{
+  if (info.iScreenWidth == 0 || info.iScreenHeight == 0 || info.fRefreshRate <= 0.0f)
+    return false;
+
+  const double clock =
+      1.5 * info.iScreenWidth * info.iScreenHeight * static_cast<double>(info.fRefreshRate);
+  return clock * 1.25 <= 600.0e6;
+}
